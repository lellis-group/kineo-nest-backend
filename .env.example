BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"
# Throwaway database replayed by `bun run db:check` to diff the migration history
# against prisma/schema.prisma. It is emptied on every run.
SHADOW_DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/kineo_shadow?schema=public"
TRUSTED_ORIGINS=http://localhost:3001
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=20
# better-auth applies a tighter, non-overridable rule to sign-in and sign-up.
# Its own default is 3 per 10 seconds, which locks out everyone sharing an
# egress IP.
CREDENTIAL_RATE_LIMIT_WINDOW=10
CREDENTIAL_RATE_LIMIT_MAX=3
SESSION_EXPIRES_IN=604800
SESSION_UPDATE_AGE=86400
REQUIRE_EMAIL_VERIFICATION=false
COOKIE_CACHE_ENABLED=true
COOKIE_CACHE_MAX_AGE=300
JWT_ENABLED=false
JWT_EXPIRATION_TIME=15m
JWT_ROTATION_INTERVAL=2592000
TRUST_PROXY=false
THROTTLE_SHORT_TTL=1000
THROTTLE_SHORT_LIMIT=5
THROTTLE_MEDIUM_TTL=10000
THROTTLE_MEDIUM_LIMIT=30
THROTTLE_LONG_TTL=60000
THROTTLE_LONG_LIMIT=150
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Kineo <noreply@localhost>"
SMTP_SECURE=false
# SMTP auth (all-or-nothing: set both or neither)
# SMTP_USER=
# SMTP_PASS=
MAX_PRACTICES_PER_PROFILE=5
MAX_ACTIVE_LISTINGS_PER_PROFILE=10
MAX_ACTIVE_APPLICATIONS_PER_PROFILE=20
FRONTEND_URL=http://localhost:3001
# Retention horizon (days) for the account-deletion audit trail (DataDeletionRequest)
DATA_DELETION_REQUEST_RETENTION_DAYS=365
