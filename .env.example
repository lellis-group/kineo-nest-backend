BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"
TRUSTED_ORIGINS=http://localhost:3001
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=20
# better-auth applies a tighter, non-overridable rule to sign-in, sign-up,
# change-password and change-email. These replace it. Its own default is 3 per
# 10 seconds, which locks out everyone sharing an egress IP.
CREDENTIAL_RATE_LIMIT_WINDOW=10
CREDENTIAL_RATE_LIMIT_MAX=3
SESSION_EXPIRES_IN=604800
SESSION_UPDATE_AGE=86400
REQUIRE_EMAIL_VERIFICATION=false
# Session cookie cache: keep OFF. It is served from a signed cookie without a
# database read, and better-auth cannot invalidate it server-side. Enabling it
# re-opens a window where a revoked session still authenticates.
COOKIE_CACHE_ENABLED=false
# Only read when the cache is enabled.
COOKIE_CACHE_MAX_AGE=300
JWT_ENABLED=false
JWT_EXPIRATION_TIME=15m
JWT_ROTATION_INTERVAL=2592000
TRUST_PROXY=false
THROTTLE_SHORT_TTL=1000
THROTTLE_SHORT_LIMIT=500
THROTTLE_MEDIUM_TTL=10000
THROTTLE_MEDIUM_LIMIT=1500
THROTTLE_LONG_TTL=60000
THROTTLE_LONG_LIMIT=3500
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Kineo <noreply@localhost>"
SMTP_SECURE=false
# SMTP auth (all-or-nothing: set both or neither)
# SMTP_USER=
# SMTP_PASS=
MAX_PRACTICES_PER_PROFILE=5
MAX_ACTIVE_LISTINGS_PER_PROFILE=10
MAX_ACTIVE_APPLICATIONS_PER_PROFILE=20
FRONTEND_URL=http://localhost:3001
# Key of the HMAC fingerprints in the account-deletion audit trail (>= 32 chars).
# Required outside development and test. Back it up with the database: without
# it the trail can no longer be searched to answer "was my request processed?".
# DELETION_PEPPER=
# Retention horizon (days) for the executed account-deletion audit trail (DataDeletionRequest)
DATA_DELETION_REQUEST_RETENTION_DAYS=365
# Retention horizon (days) for a deletion request that was never confirmed
PENDING_DELETION_REQUEST_RETENTION_DAYS=30
# Delay (days) between anonymizing an account and dropping it for good
ACCOUNT_PURGE_GRACE_DAYS=30
# Throttle for the anonymous account-deletion confirmation endpoint
THROTTLE_DELETION_LIMIT=5
THROTTLE_DELETION_TTL=900000
