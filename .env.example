# At least 32 characters: better-auth signs with this, and it is also what the
# keyed fingerprints in the erasure trail are derived from.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
PORT=3000
# Absent means production: the gates (Swagger, Secure cookies, sanitised error
# bodies) close by default rather than by intent. Set it to development or test to
# open them.
NODE_ENV=development
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"
# Throwaway database replayed by `bun run db:check` to diff the migration history
# against prisma/schema.prisma. It is emptied on every run.
SHADOW_DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/kineo_shadow?schema=public"
# Admin URL of the same instance, required by the e2e suites: each one creates
# and drops its own throwaway database, which only the superuser role can do.
TEST_DATABASE_ADMIN_URL="postgresql://johndoe:randompassword@localhost:5432/postgres"
# Optional. Without it the throttler and better-auth's own rate limiter both
# count in memory, which is per process: N replicas then allow N times the
# configured budget. `bun run compose up redis` (docker-compose.yml) starts one
# locally.
REDIS_URL=redis://localhost:6379
# Optional, and only for the readiness probe: `/health?deep=1&token=<this>`. Absent,
# `/health` answers liveness only — no uptime, no database state, to anyone.
HEALTH_DEEP_TOKEN=
TRUSTED_ORIGINS=http://localhost:3001
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=20
# better-auth applies a tighter, non-overridable rule to sign-in and sign-up.
# Its own default is 3 per 10 seconds, which locks out everyone sharing an
# egress IP.
CREDENTIAL_RATE_LIMIT_WINDOW=10
CREDENTIAL_RATE_LIMIT_MAX=3
# Same story for POST /api/auth/change-email, which better-auth also rate-limits
# on its own: 10 attempts per 15 minutes, not reachable through RATE_LIMIT_MAX.
# Looser than the credential limit on purpose, because this endpoint sends emails
# and a change takes two of them before anything is applied.
CHANGE_EMAIL_RATE_LIMIT_WINDOW=900
CHANGE_EMAIL_RATE_LIMIT_MAX=10
SESSION_EXPIRES_IN=604800
SESSION_UPDATE_AGE=86400
# Key of the HMAC fingerprints in the account-deletion audit trail (>= 32 chars).
# Required outside development and test. Back it up with the database: without it
# the trail can no longer be searched to answer "was my request processed?".
# DELETION_PEPPER=
# Delay in days between anonymizing an account and dropping it for good
ACCOUNT_PURGE_GRACE_DAYS=30
# Retention horizon (days) for the executed account-deletion audit trail
DATA_DELETION_REQUEST_RETENTION_DAYS=365
# Retention horizon (days) for a request that was never confirmed. Two horizons,
# both anchored on the row's last write rather than on when the request was made:
# a request confirmed today serves its full retention from today, however long ago
# it was asked for. Minimum 2 — the confirmation link lives 24 hours, and a shorter
# horizon sweeps the pending row while its own link is still usable, after which
# every confirmation refuses.
PENDING_DELETION_REQUEST_RETENTION_DAYS=30
# Throttle for the anonymous confirmation endpoint, which has no session to
# fall back on: the token is the only proof of identity
THROTTLE_DELETION_LIMIT=5
THROTTLE_DELETION_TTL=900000
# Unset means true outside development and test.
#
# better-auth gates the approval step of a change of address on the session's
# address already being verified, so with this off that step never runs: the new
# address is emailed directly and the old one is never asked. Read the cost
# before turning it off — a new account then signs in without having clicked its
# verification link.
REQUIRE_EMAIL_VERIFICATION=false
# Off unless asked for. With it on, better-auth bakes the session *and the user
# row* into a signed cookie, and only a `version` function invalidates it — which
# this project does not register, so a row that was anonymized or re-verified
# would keep being served from the cookie. Turn it on only with one.
COOKIE_CACHE_ENABLED=false
COOKIE_CACHE_MAX_AGE=300
JWT_ENABLED=false
JWT_EXPIRATION_TIME=15m
JWT_ROTATION_INTERVAL=2592000
# Unset means true outside development/test (this app runs behind a proxy); false
# in development, where trusting one hides the real client address.
TRUST_PROXY=false
# Addresses or CIDR ranges of the proxies themselves: TRUST_PROXY says that a
# proxy is there, this says which one. better-auth walks the forwarded-for chain
# right to left, skips these hops and takes the first untrusted address as the
# client IP — for its rate-limit keys and the Session.ipAddress column alike.
# The same list is Express's trust proxy setting, so the throttler's req.ip
# resolves the same client.
# Without it, a chain of two or more (CDN plus load balancer, or any caller who
# sends their own header that the proxy appends to) resolves to no client at all,
# and every such caller collapses into one shared rate-limit bucket.
# Use the real addresses of your proxies: a range that also covers clients lets
# a caller pick its own address by sending enough hops for the walk to stop on it.
# TRUST_PROXY_IPS=10.0.0.0/8
THROTTLE_SHORT_TTL=1000
THROTTLE_SHORT_LIMIT=5
THROTTLE_MEDIUM_TTL=10000
THROTTLE_MEDIUM_LIMIT=30
THROTTLE_LONG_TTL=60000
THROTTLE_LONG_LIMIT=150
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Kineo <noreply@localhost>"
SMTP_SECURE=false
# SMTP auth (all-or-nothing: set both or neither)
# SMTP_USER=
# SMTP_PASS=
MAX_PRACTICES_PER_PROFILE=5
MAX_ACTIVE_LISTINGS_PER_PROFILE=10
MAX_ACTIVE_APPLICATIONS_PER_PROFILE=20
FRONTEND_URL=http://localhost:3001

# Ceiling on practices drawn on the /listings map. The response's `truncated`
# tells the client when it bites, so it is safe to tune.
MAX_BROWSE_MAP_PLACES=200
# Ceiling of the one connection pool the application and better-auth share
# (DATABASE_URL's pool). The pg default of 10 per client served while there were
# three clients; with one, the number is what a replica costs against the
# database's `max_connections`. Absent, the default stands. Size with the
# replicas in mind rather than the pool: N replicas of max M are N*M connections.
# DATABASE_POOL_MAX=10
# Makes Prisma log every statement it sends. A diagnostic, not a setting for
# production: it writes one line per query, and the reader is the one who has to
# recognise which of them is the slow one. Off by default; turning it on never
# silences Prisma's own warnings and errors, only adds to them.
PRISMA_LOG_QUERIES=false
