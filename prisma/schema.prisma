generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  emailVerified Boolean   @default(false)
  image         String?
  /**
   * Set when the erasure request (art. 17 GDPR) has been executed: every
   * personal field is already overwritten and access is revoked, the row only
   * survives until the deferred purge drops it with its cascade.
   */
  deletedAt     DateTime?
  accounts      Account[]
  sessions      Session[]
  profile       Profile?

  @@index([deletedAt])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier], type: Hash)
  @@map("verification")
}

model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?

  @@map("jwks")
}

enum ProfileType {
  INSTALLED
  REPLACEMENT
  BOTH
}

enum Specialty {
  GENERALIST
  DENTIST
  DERMATOLOGIST
  PSYCHIATRIST
  OTHER
}

enum ListingStatus {
  DRAFT
  OPEN
  IN_DISCUSSION
  FULL
  FILLED
  CLOSED
  CLOSED_NO_CANDIDATE
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum DataDeletionRequestStatus {
  PENDING
  ANONYMIZED
  SUPERSEDED
}

model Profile {
  id           String               @id @default(cuid())
  userId       String               @unique
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  rppsNumber   String?              @unique
  specialty    Specialty
  profileType  ProfileType
  verified     Boolean              @default(false)
  isPublic     Boolean              @default(true)
  city         String?
  latitude     Float?
  longitude    Float?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  practices    Practice[]
  listings     ReplacementListing[] @relation("CreatedListings")
  applications Application[]

  @@index([specialty], where: { isPublic: true })
  @@map("profile")
}

model Practice {
  id        String               @id @default(cuid())
  ownerId   String
  owner     Profile              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  address   String
  city      String
  latitude  Float?
  longitude Float?
  isPublic  Boolean              @default(true)
  createdAt DateTime             @default(now())
  listings  ReplacementListing[]

  @@index([ownerId])
  @@index([latitude, longitude])
  @@map("practice")
}

model ReplacementListing {
  id              String        @id @default(cuid())
  practiceId      String
  practice        Practice      @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  createdById     String
  createdBy       Profile       @relation("CreatedListings", fields: [createdById], references: [id], onDelete: Cascade)
  title           String
  startDate       DateTime
  endDate         DateTime
  specialty       Specialty
  status          ListingStatus @default(DRAFT)
  urgent          Boolean       @default(false)
  description     String?
  maxApplications Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  applications    Application[]

  @@index([createdAt(sort: Desc)], where: { status: "OPEN" }, map: "rl_open_createdAt_idx")
  @@index([createdAt(sort: Desc)], where: { status: "IN_DISCUSSION" }, map: "rl_indisc_createdAt_idx")
  @@index([practiceId])
  @@index([createdById, status])
  @@map("replacement_listing")
}

model Application {
  id              String             @id @default(cuid())
  listingId       String
  listing         ReplacementListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  applicantId     String
  applicant       Profile            @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  status          ApplicationStatus  @default(PENDING)
  message         String?
  rejectionReason String?
  withdrawnReason String?
  viewedAt        DateTime?
  respondedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([listingId, applicantId])
  @@index([applicantId])
  @@index([listingId, createdAt(sort: Desc)], where: { status: "PENDING" }, map: "app_listing_pending_idx")
  @@index([listingId, createdAt(sort: Desc)], where: { status: "SHORTLISTED" }, map: "app_listing_shortlisted_idx")
  @@index([applicantId, createdAt(sort: Desc)], where: { status: "PENDING" }, map: "app_applicant_pending_idx")
  @@index([applicantId, createdAt(sort: Desc)], where: { status: "SHORTLISTED" }, map: "app_applicant_shortlisted_idx")
  @@map("application")
}

/**
 * GDPR accountability trail (art. 5(2), 17): records each account-deletion
 * request and its execution. Deliberately has NO foreign key to `user`: the
 * row must survive the account purge so the request/execution timeline stays
 * provable.
 *
 * Identifiers are stored as keyed fingerprints (HMAC-SHA256 over a
 * server-side pepper), never as plaintext. Erasing the account must not leave
 * the email sitting in an audit table for a year; the fingerprint still allows
 * an operator to answer "was my request processed?" and to deduplicate
 * requests without holding personal data.
 */
model DataDeletionRequest {
  id         String                    @id @default(cuid())
  userIdHash String
  emailHash   String
  status     DataDeletionRequestStatus @default(PENDING)
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt
  executedAt DateTime?

  @@index([userIdHash, createdAt(sort: Desc)])
  // UNIQUE, not a plain index: it is the only thing that makes a second
  // PENDING request for the same person impossible. `sendDeleteAccountVerification`
  // supersedes the previous one and inserts a new row, and it runs at
  // READ COMMITTED, so two concurrent requests can both read "one PENDING" and
  // both insert. Without UNIQUE both rows land and the erasure trail is
  // ambiguous. Declared `unique: true` so `migrate dev` stops proposing to
  // downgrade it — which it did once, silently.
  @@unique([userIdHash], where: { status: "PENDING" }, map: "data_deletion_request_userIdHash_idx")
  @@index([status, updatedAt])
  @@map("data_deletion_request")
}
