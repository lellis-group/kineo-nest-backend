generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  emailVerified Boolean   @default(false)
  image         String?
  /// Set when the account has been anonymized by an erasure. The row stays, and
  /// is only dropped by the purge sweep once the grace period has passed, so the
  /// anonymized listings keep resolving to a real owner during that window.
  deletedAt     DateTime?
  accounts      Account[]
  sessions      Session[]
  profile       Profile?

  @@index([deletedAt])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // The hourly retention sweep deletes on expiresAt alone, in the process that
  // serves requests.
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // The erasure purges by identifier prefix, which is a range: a HASH index
  // serves equality only, and the existing btree on identifier alone is the one
  // that can answer it.
  @@index([identifier])
  @@index([expiresAt])
  @@index([identifier, expiresAt])
  @@map("verification")
}

model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?

  @@map("jwks")
}

enum ProfileType {
  INSTALLED
  REPLACEMENT
  BOTH
}

enum Specialty {
  GENERALIST
  DENTIST
  DERMATOLOGIST
  PSYCHIATRIST
  OTHER
}

/// Who moved a settled application to its final status.
enum DecisionSource {
  PRACTICE_ACCEPTED
  PRACTICE_REJECTED
  CANDIDATE_WITHDREW
  SYSTEM
}

enum ListingStatus {
  DRAFT
  OPEN
  IN_DISCUSSION
  FULL
  FILLED
  CLOSED
  CLOSED_NO_CANDIDATE
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum DataDeletionRequestStatus {
  PENDING
  ANONYMIZED
  SUPERSEDED
}

model Profile {
  id           String               @id @default(cuid())
  userId       String               @unique
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  rppsNumber   String?              @unique
  specialty    Specialty
  profileType  ProfileType
  verified     Boolean              @default(false)
  isPublic     Boolean              @default(true)
  city         String?
  latitude     Float?
  longitude    Float?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  practices    Practice[]
  listings     ReplacementListing[] @relation("CreatedListings")
  applications Application[]

  @@index([specialty], where: { isPublic: true })
  @@map("profile")
}

model Practice {
  id        String               @id @default(cuid())
  ownerId   String
  owner     Profile              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  address   String
  city      String
  latitude  Float?
  longitude Float?
  isPublic  Boolean              @default(true)
  createdAt DateTime             @default(now())
  listings  ReplacementListing[]

  @@index([ownerId])
  @@index([latitude, longitude])
  @@map("practice")
}

model ReplacementListing {
  id              String        @id @default(cuid())
  practiceId      String
  practice        Practice      @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  createdById     String
  createdBy       Profile       @relation("CreatedListings", fields: [createdById], references: [id], onDelete: Cascade)
  title           String
  startDate       DateTime
  endDate         DateTime
  specialty       Specialty
  status          ListingStatus @default(DRAFT)
  urgent          Boolean       @default(false)
  description     String?
  maxApplications Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  applications    Application[]

  @@index([createdAt(sort: Desc)], where: { status: "OPEN" }, map: "rl_open_createdAt_idx")
  @@index([createdAt(sort: Desc)], where: { status: "IN_DISCUSSION" }, map: "rl_indisc_createdAt_idx")
  @@index([practiceId])
  @@index([createdById, status])
  @@map("replacement_listing")
}

model Application {
  id              String             @id @default(cuid())
  listingId       String
  listing         ReplacementListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  applicantId     String
  applicant       Profile            @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  status          ApplicationStatus  @default(PENDING)
  decisionSource  DecisionSource?
  message         String?
  rejectionReason String?
  withdrawnReason String?
  viewedAt        DateTime?
  respondedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([listingId, applicantId])
  @@index([applicantId])
  @@index([applicantId, status])
  @@index([listingId, createdAt(sort: Desc)], where: { status: "PENDING" }, map: "app_listing_pending_idx")
  @@index([listingId, createdAt(sort: Desc)], where: { status: "SHORTLISTED" }, map: "app_listing_shortlisted_idx")
  @@index([applicantId, createdAt(sort: Desc)], where: { status: "PENDING" }, map: "app_applicant_pending_idx")
  @@index([applicantId, createdAt(sort: Desc)], where: { status: "SHORTLISTED" }, map: "app_applicant_shortlisted_idx")
  @@map("application")
}

/**
 * GDPR accountability trail (art. 5(2), 17): records each account-deletion
 * request and its execution. Deliberately has NO foreign key to `user`: the
 * row must survive the account hard delete (which cascades everything else)
 * so the request/execution timeline stays provable.
 */
/// Art. 5(2) accountability trail. The identifiers are keyed fingerprints: the
/// trail has to answer "was my request processed?" without keeping the email it
/// is about, and the pepper that produces them never reaches the database.
model DataDeletionRequest {
  id         String                    @id @default(cuid())
  userIdHash String
  emailHash  String
  status     DataDeletionRequestStatus @default(PENDING)
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt
  executedAt DateTime?

  // UNIQUE, not a plain index: it is the only thing that makes a second PENDING
  // request for the same person impossible. A new confirmation link supersedes
  // the previous one and inserts a new row, so two concurrent requests can both
  // read "one PENDING" and both insert.
  @@unique([userIdHash], where: { status: "PENDING" }, map: "data_deletion_request_userIdHash_idx")
  @@index([userIdHash, createdAt(sort: Desc)])
  @@index([status, updatedAt])
  @@map("data_deletion_request")
}
