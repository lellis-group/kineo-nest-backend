{
  "name": "kineo-nest-backend",
  "private": true,
  "packageManager": "bun@1.4.2",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "bun x tsc -p tsconfig.build.json",
    "start": "bun dist/main.js",
    "typecheck": "bun x tsc -p tsconfig.json --noEmit",
    "test": "bun test src --path-ignore-patterns '**/e2e/**'",
    "test:coverage": "bun run scripts/coverage-gate.ts",
    "test:watch": "bun test src --watch --path-ignore-patterns '**/e2e/**'",
    "lint": "biome check src prisma scripts",
    "lint:fix": "biome check --write src prisma scripts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:check": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code",
    "test:e2e": "bun run scripts/e2e-all.ts",
    "test:e2e:routes": "bun run scripts/serialized-routes.e2e-coverage.ts",
    "test:all": "bun run test && bun run test:e2e",
    "test:e2e:cascade": "KINEO_E2E_SUITE=cascade bun test --timeout 15000 src/common/e2e/third-party-cascade.e2e.test.ts",
    "test:e2e:erasure": "KINEO_E2E_SUITE=erasure bun test --timeout 15000 src/common/e2e/erasure-bypass.e2e.test.ts",
    "test:e2e:guard": "KINEO_E2E_SUITE=guard bun test --timeout 15000 src/common/e2e/email-verified-guard.e2e.test.ts",
    "test:e2e:geo": "KINEO_E2E_SUITE=geo bun test --timeout 15000 src/practices/e2e/geo-search.e2e.test.ts",
    "test:e2e:change-email": "KINEO_E2E_SUITE=change-email bun test --timeout 15000 src/common/e2e/change-email.e2e.test.ts",
    "test:e2e:account-emails": "KINEO_E2E_SUITE=account-emails bun test --timeout 15000 src/common/e2e/account-emails.e2e.test.ts",
    "test:e2e:input-validation": "KINEO_E2E_SUITE=input-validation bun test --timeout 15000 src/common/e2e/auth-input-validation.e2e.test.ts",
    "test:e2e:applications": "KINEO_E2E_SUITE=applications bun test --timeout 15000 src/common/e2e/applications-filters.e2e.test.ts",
    "test:e2e:apptransitions": "KINEO_E2E_SUITE=apptransitions bun test --timeout 15000 src/applications/e2e/applications-transitions.e2e.test.ts",
    "test:e2e:listings": "KINEO_E2E_SUITE=listings bun test --timeout 15000 src/replacementlistings/e2e/listings-lifecycle.e2e.test.ts",
    "test:e2e:profile": "KINEO_E2E_SUITE=profile bun test --timeout 15000 src/profile/e2e/profile-crud.e2e.test.ts",
    "test:e2e:practices": "KINEO_E2E_SUITE=practices-crud bun test --timeout 15000 src/practices/e2e/practices-crud.e2e.test.ts",
    "test:e2e:authguard": "KINEO_E2E_SUITE=authguard bun test --timeout 15000 src/common/e2e/global-auth-guard.e2e.test.ts",
    "test:e2e:sessioncookie": "KINEO_E2E_SUITE=sessioncookie bun test --timeout 15000 src/common/e2e/session-cookie.e2e.test.ts",
    "test:e2e:bodylimit": "KINEO_E2E_SUITE=bodylimit bun test --timeout 15000 src/common/e2e/body-limit.e2e.test.ts",
    "test:e2e:sweeplock": "KINEO_E2E_SUITE=sweeplock bun test --timeout 15000 src/data-lifecycle/e2e/sweep-lock.e2e.test.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.3",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/schedule": "^12.0.1",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "better-auth": "1.7.3",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.3",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^10.0.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/bun": "^1.3.14",
    "@types/compression": "^1.8.1",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.9.1",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "multer": "^2.4.0"
  }
}
