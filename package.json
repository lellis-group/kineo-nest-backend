{
  "name": "kineo-nest-backend",
  "private": true,
  "packageManager": "bun@1.4.2",
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "bun dist/main.js",
    "typecheck": "bun x tsc -p tsconfig.json --noEmit",
    "test": "bun test src --path-ignore-patterns '**/e2e/**'",
    "test:watch": "bun test src --watch --path-ignore-patterns '**/e2e/**'",
    "lint": "biome check src prisma",
    "lint:fix": "biome check --write src prisma",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:check": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code",
    "test:e2e": "bun run test:e2e:cascade && bun run test:e2e:erasure",
    "test:all": "bun run test && bun run test:e2e",
    "test:e2e:cascade": "KINEO_E2E_SUITE=cascade bun test src/common/e2e/third-party-cascade.e2e.test.ts",
    "test:e2e:erasure": "KINEO_E2E_SUITE=erasure bun test src/common/e2e/erasure-bypass.e2e.test.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.3",
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/schedule": "^12.0.1",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "better-auth": "1.7.3",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.3",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^9.0.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@prisma/compute-sdk": "latest",
    "@types/bun": "^1.3.14",
    "@types/compression": "^1.8.1",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.9.1",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3"
  }
}
