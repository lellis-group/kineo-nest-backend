{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist"
  },
  // The generated Prisma client is deliberately absent: `exclude` does not stop
  // it from being compiled, because prisma.service.ts imports it. Listing it
  // implied the opposite.
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.spec.ts",
    "src/**/*.e2e.test.ts",
    "src/**/e2e/**"
  ]
}